# Copy to .env. Never commit real keys.
CLUE_LLM_PROVIDER=mock            # mock | openrouter | openai | local | anthropic
CLUE_LLM_MODEL=mock               # e.g. openai/gpt-4o-mini (openrouter), llama3.1 (local)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1   # used by provider=local (Ollama default)
CLUE_LLM_CACHE=eval/live/cache    # optional on-disk response cache: identical prompts are free on re-run
CLUE_LLM_TIMEOUT=60               # per-request timeout (s); 4 retries with exponential backoff on 429/5xx
