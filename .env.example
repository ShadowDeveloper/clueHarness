# Copy to .env. Never commit real keys.
CLUE_LLM_PROVIDER=mock            # mock | openrouter | openai | local | anthropic
CLUE_LLM_MODEL=mock               # any model id accepted by the selected endpoint

# Optional wire-format override (provider defaults are usually sufficient):
# CLUE_LLM_API=chat_completions   # chat_completions | completions | responses | messages
# CLUE_LLM_API_KEY=               # generic key for any provider; Authorization Bearer or x-api-key as appropriate
# CLUE_LLM_BASE_URL=              # versioned base URL, e.g. https://api.openai.com/v1

# Provider-specific credentials/URLs (generic CLUE_LLM_* values take precedence):
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LOCAL_API_KEY=ollama               # some local servers require any non-empty key
# LOCAL_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=http://localhost:11434/v1  # backwards-compatible local base URL

CLUE_LLM_CACHE=eval/live/cache     # optional on-disk response cache: identical prompts are free on re-run
CLUE_LLM_TIMEOUT=60                # per-request timeout (s)
CLUE_LLM_MAX_RETRIES=4             # retries with exponential backoff on 429/5xx/timeouts
CLUE_LLM_MAX_TOKENS=1500           # max output tokens; translated to each API's parameter
